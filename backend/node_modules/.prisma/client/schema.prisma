generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users          OrganizationUser[]
  clients        Client[]
  expedientes    Expediente[]
  tasks          Task[]
  calendarEvents CalendarEvent[]
  documents      Document[]
  tags           Tag[]
  aiQueries      AiQuery[]
  templates      Template[]
  aiDrafts       AiDraft[]
  auditLogs      AuditLog[]
  aiLogs         AiLog[]

  @@map("organizations")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  createdAt    DateTime @default(now()) @map("created_at")

  organizations   OrganizationUser[]
  userRoles       UserRole[]
  expedienteUsers ExpedienteUser[]
  alerts          Alert[]
  documents       Document[] // Uploaded by
  queries         AiQuery[]
  auditLogs       AuditLog[]

  @@map("users")
}

model Role {
  id   String @id @default(uuid())
  name String @unique

  userRoles         UserRole[]
  organizationUsers OrganizationUser[]

  @@map("roles")
}

model UserRole {
  userId String @map("user_id")
  roleId String @map("role_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model OrganizationUser {
  orgId  String  @map("org_id")
  userId String  @map("user_id")
  roleId String? @map("role_id")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role?        @relation(fields: [roleId], references: [id], onDelete: SetNull)

  @@id([orgId, userId])
  @@map("organization_users")
}

model Client {
  id         String   @id @default(uuid())
  orgId      String   @map("org_id")
  name       String
  email      String?
  phone      String?
  documentId String?  @map("document_id") // DNI, CUIT, etc
  createdAt  DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  expedientes  Expediente[]

  @@map("clients")
}

model Expediente {
  id          String   @id @default(uuid())
  orgId       String   @map("org_id")
  clientId    String   @map("client_id")
  title       String
  description String?
  status      String   @default("OPEN")
  createdAt   DateTime @default(now()) @map("created_at")

  organization Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  client       Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  users        ExpedienteUser[]
  tasks        Task[]
  events       CalendarEvent[]
  documents    Document[]
  aiQueries    AiQuery[]
  aiDrafts     AiDraft[]

  @@map("expedientes")
}

model ExpedienteUser {
  expedienteId String @map("expediente_id")
  userId       String @map("user_id")
  permissions  String @default("READ")

  expediente Expediente @relation(fields: [expedienteId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([expedienteId, userId])
  @@map("expediente_users")
}

model Task {
  id           String    @id @default(uuid())
  orgId        String    @map("org_id")
  expedienteId String    @map("expediente_id")
  title        String
  description  String?
  status       String    @default("TODO")
  dueDate      DateTime? @map("due_date")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  expediente   Expediente   @relation(fields: [expedienteId], references: [id], onDelete: Cascade)

  @@map("tasks")
}

model CalendarEvent {
  id           String   @id @default(uuid())
  orgId        String   @map("org_id")
  expedienteId String?  @map("expediente_id")
  title        String
  startTime    DateTime @map("start_time")
  endTime      DateTime @map("end_time")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  expediente   Expediente?  @relation(fields: [expedienteId], references: [id], onDelete: SetNull)

  @@map("calendar_events")
}

model Alert {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  message   String
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("alerts")
}

model Document {
  id           String   @id @default(uuid())
  orgId        String   @map("org_id")
  expedienteId String   @map("expediente_id")
  fileName     String   @map("file_name")
  minioKey     String   @map("minio_key")
  status       String   @default("PENDING") // PENDING, PROCESSING, COMPLETED, ERROR
  uploadedById String   @map("uploaded_by")
  createdAt    DateTime @default(now()) @map("created_at")

  organization Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  expediente   Expediente        @relation(fields: [expedienteId], references: [id], onDelete: Cascade)
  uploadedBy   User              @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  versions     DocumentVersion[]
  tags         DocumentTag[]
  texts        DocumentText?
  chunks       DocumentChunk[]
  summaries    AiSummary[]
  extractions  AiExtraction[]

  @@map("documents")
}

model DocumentVersion {
  id         String   @id @default(uuid())
  documentId String   @map("document_id")
  minioKey   String   @map("minio_key")
  version    Int
  createdAt  DateTime @default(now()) @map("created_at")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("document_versions")
}

model Tag {
  id    String @id @default(uuid())
  orgId String @map("org_id")
  name  String

  organization Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  documents    DocumentTag[]

  @@map("tags")
}

model DocumentTag {
  documentId String @map("document_id")
  tagId      String @map("tag_id")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([documentId, tagId])
  @@map("document_tags")
}

model DocumentText {
  id         String @id @default(uuid())
  documentId String @unique @map("document_id")
  rawText    String @map("raw_text")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("document_texts")
}

model DocumentChunk {
  id         String @id @default(uuid())
  documentId String @map("document_id")
  chunkIndex Int    @map("chunk_index")
  content    String

  document  Document                     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  // Unsupported type in prisma means we use raw queries/types for it
  embedding Unsupported("vector(1536)")?

  @@map("document_chunks")
}

model AiSummary {
  id          String @id @default(uuid())
  documentId  String @map("document_id")
  summaryText String @map("summary_text")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("ai_summaries")
}

model AiExtraction {
  id               String @id @default(uuid())
  documentId       String @map("document_id")
  entityType       String @map("entity_type") // e.g., PARTY, FACT, DATE
  extractedContent String @map("extracted_content")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("ai_extractions")
}

model AiQuery {
  id           String  @id @default(uuid())
  orgId        String  @map("org_id")
  expedienteId String? @map("expediente_id")
  userId       String  @map("user_id")
  queryText    String  @map("query_text")
  responseText String  @map("response_text")
  // For sources we can store a simple json array of chunk ids or references
  sources      Json?

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  expediente   Expediente?  @relation(fields: [expedienteId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ai_queries")
}

model Template {
  id      String @id @default(uuid())
  orgId   String @map("org_id")
  name    String
  content String

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  aiDrafts     AiDraft[]

  @@map("templates")
}

model AiDraft {
  id               String @id @default(uuid())
  orgId            String @map("org_id")
  expedienteId     String @map("expediente_id")
  templateId       String @map("template_id")
  generatedContent String @map("generated_content")
  status           String @default("DRAFT")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  expediente   Expediente   @relation(fields: [expedienteId], references: [id], onDelete: Cascade)
  template     Template     @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@map("ai_drafts")
}

model AuditLog {
  id         String   @id @default(uuid())
  orgId      String   @map("org_id")
  userId     String   @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  details    Json?
  createdAt  DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("audit_logs")
}

model AiLog {
  id               String   @id @default(uuid())
  orgId            String   @map("org_id")
  action           String
  promptTokens     Int      @default(0) @map("prompt_tokens")
  completionTokens Int      @default(0) @map("completion_tokens")
  model            String
  createdAt        DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("ai_logs")
}
