# Environment Variables - Copiloto Jurídico

# Frontend Setup
NEXT_PUBLIC_API_URL=http://localhost:4000

# Backend Setup
PORT=4000
NODE_ENV=development

# Database Configuration (PostgreSQL + pgvector)
# Change the user, password and db_name if modified in docker-compose.yml
DATABASE_URL="postgresql://postgres:copiloto_secret@127.0.0.1:5433/copiloto_db?schema=public"

# Redis Configuration (For Queues / Caching)
REDIS_HOST=localhost
REDIS_PORT=6379

# MinIO Configuration (Storage)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=admin_secret_123
MINIO_BUCKET_NAME=copiloto-documents
MINIO_USE_SSL=false

# Auth
JWT_SECRET=super_secret_jwt_development_key
JWT_EXPIRES_IN=1d

# OpenAI or generic LLM
OPENAI_API_KEY=sk-your-openai-api-key-here
